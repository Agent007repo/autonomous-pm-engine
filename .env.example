# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pm_engine_secret

# ChromaDB
CHROMA_MODE=server
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=pm_engine

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Chunking and retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=64
SEMANTIC_SPLIT_THRESHOLD=0.65
TOP_K_RETRIEVAL=10
HYBRID_ALPHA=0.7

# Agent behavior
MAX_CRITIQUE_ROUNDS=3
ENGINEERING_GATE_THRESHOLD=7.0

# Output and logging
OUTPUT_DIR=outputs/
PRD_VERSION=1.0
LOG_LEVEL=INFO
LOG_FILE=logs/pm_engine.log
